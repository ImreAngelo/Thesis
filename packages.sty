%% Plots
\usepackage{pgfplots}
\usepackage{pgfplotstable}
\usepgfplotslibrary{groupplots}
\usetikzlibrary{positioning, arrows.meta}
\usetikzlibrary{plotmarks}
\pgfplotsset{compat=1.18}
 
% ---- Color palette ----
\definecolor{gaussblue}{RGB}{31,119,180}
\definecolor{hpsgreen}{RGB}{44,160,44}
\definecolor{canonorange}{RGB}{255,165,0}
\definecolor{maxred}{RGB}{255,36,0}
\definecolor{hpspurple}{RGB}{148,103,189}
 
% ---- Shared line styles ----
\pgfplotsset{
  stderr line/.style={black, dashed, thick},
  gaussian line/.style={gaussblue, densely dotted, thick},
  hps line/.style={hpsgreen, dash dot, thick},
  canonical line/.style={canonorange, dash dot, thick},
  maxnoise line/.style={maxred, solid, thick},
  hpssqrt line/.style={hpspurple, dash dot, thick},
  noiseaxis/.style={
    width=6.4cm, height=4.9cm,
    % xlabel={\#Mult},
    % ylabel={$\log_2(v)-\log_2(\sigma)$},
    xmin=0, xmax=33,
    domain=1:32, samples=64, smooth, no markers,
    legend cell align=left,
    legend style={
      at={(0.03,0.97)}, anchor=north west,
      font=\scriptsize, draw=black, fill=white,
      inner sep=2pt, row sep=-1pt,
    },
    every axis plot post/.append style={line width=0.9pt},
    tick label style={font=\scriptsize},
    label style={font=\small},
    axis line style={line width=0.6pt},
  },
}

