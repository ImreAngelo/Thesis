% Operators
\DeclareMathOperator{\sign}{sign}

% Internal product operator: an asterisk boxed like amssymb's \boxdot
% (amssymb provides \boxplus/\boxminus/\boxtimes/\boxdot but not \boxast)
\newcommand{\boxast}{\mathbin{\ooalign{$\square$\cr\hidewidth\raisebox{0.2ex}{$\scriptstyle\ast$}\hidewidth\cr}}}

% Autoref
\newcommand{\algorithmautorefname}{Algorithm}

% Code
\usepackage{minted}

% Diagrams
\usepackage{tikz-cd}

% Load clean numbers from JSON
\usepackage{jsonparse}
\usepackage{siunitx}
\sisetup{round-mode = places, round-precision = 2}

\ExplSyntaxOn
% expands the JSON value, converts sci notation to a plain decimal, rounds to 2 places
\NewExpandableDocumentCommand { \jsonms } { m m }
  { \fp_eval:n { round ( \JSONParseExpandableValue {#1} {#2} , 2 ) } }
\ExplSyntaxOff

% Numbers
\ExplSyntaxOn
\clist_new:N \l_myn_clist
\clist_set:Nn \l_myn_clist { 2, 32, 64, 128 }
% \nvalue{<0-based index>} -> item from the list
\NewExpandableDocumentCommand { \nvalue } { m }
  { \clist_item:Nn \l_myn_clist { #1 + 1 } }  % clist is 1-based
\ExplSyntaxOff

\ExplSyntaxOn
\NewExpandableDocumentCommand { \jsonmspern } { m m m }
  { \fp_eval:n { round ( \JSONParseExpandableValue {#1} {#2} / (#3) , 2 ) } }
\ExplSyntaxOff

